# --- Model provider -------------------------------------------------------
# OpenAI by default. CHAT_MODEL must support the Responses API; with a
# non-reasoning model, leave REASONING_EFFORT empty.
OPENAI_API_KEY=
CHAT_MODEL=gpt-5-mini
EMBEDDING_MODEL=text-embedding-3-small
REASONING_EFFORT=low

# Azure OpenAI instead: set these (and leave OPENAI_API_KEY empty).
# OPENAI_PROVIDER=azure
# AZURE_OPENAI_ENDPOINT=
# AZURE_OPENAI_API_KEY=
# AZURE_OPENAI_CHAT_DEPLOYMENT=
# AZURE_OPENAI_EMBEDDING_DEPLOYMENT=

# Optional: embeddings from a local OpenAI-compatible server.
# EMBEDDING_BASE_URL=http://localhost:11434/v1
# EMBEDDING_MODEL=nomic-embed-text

# --- Documents ------------------------------------------------------------
# One folder per machine: "IMM <number> - <MAKE> (<model>) <serial>".
# Shared troubleshooting documents go in DOCS_ROOT/_general.
DOCS_ROOT=./data/documents
# GENERAL_DOCS_PATH=

# --- Storage --------------------------------------------------------------
APP_DB_PATH=./data/app.db

# --- Auth -----------------------------------------------------------------
# Must be a stable random value. Generate with:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
SESSION_SECRET=
AUTH_REQUIRED=true
# Browsers drop a Secure cookie over plain http, so local http sign-in needs
# this false. Keep it true anywhere served over https.
SESSION_HTTPS_ONLY=false
